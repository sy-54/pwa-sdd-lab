{
  "name": "pwa-sdd-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "lint:sdd": "tsx harness/lint/cli.ts",
    "harness": "tsx harness/run.ts",
    "summary": "tsx harness/grade/summary.ts",
    "build:platform": "tsx platform/scripts/build.ts",
    "e2e:platform": "playwright test -c platform/playwright.config.ts",
    "check:platform": "npm run build:platform && vitest run platform && npm run e2e:platform",
    "regrade": "tsx harness/grade/regrade.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
